# ============================================================================
# MadHaus — environment
# Copy to `.env.local` and fill in. NEVER commit a filled-in copy.
# Every value here is read on the server only. Anything the browser may see must
# be prefixed NEXT_PUBLIC_ and must not be a secret.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Public origin, used for canonical URLs, sitemap, OG images and booking links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database ---------------------------------------------------------------
# `docker compose up -d` serves exactly this on port 5433.
DATABASE_URL="postgresql://madhaus:madhaus_dev_only@localhost:5433/madhaus"

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# --- Sanity -----------------------------------------------------------------
# From sanity.io/manage. The project id and dataset are public by design.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-10-01"
# Viewer token, needed only to read drafts for preview. Keep it server-side.
SANITY_API_READ_TOKEN=""
# Server-only write token for Admin menu photo uploads and the Sanity seeder.
SANITY_API_WRITE_TOKEN=""
# Shared secret for the revalidation webhook. Must match the secret set on the
# webhook in sanity.io/manage, or revalidation requests are rejected.
SANITY_REVALIDATE_SECRET=""

# --- Payments ---------------------------------------------------------------
# Comma-separated, in the order they are offered.
# Available: pay_at_venue, jazzcash, simulator
# `simulator` refuses to load when NODE_ENV=production.
PAYMENT_PROVIDERS="pay_at_venue,jazzcash"

# JazzCash account the customer transfers to. Shown on the payment page.
# Leave blank and online payment is simply not offered — only pay-at-venue.
# Nothing here talks to JazzCash: the customer transfers by hand and a member of
# staff matches the transaction ID against the account before confirming.
JAZZCASH_ACCOUNT_TITLE=""
JAZZCASH_ACCOUNT_NUMBER=""

# --- Notifications ----------------------------------------------------------
# Comma-separated: log, email, sms, whatsapp
# `log` writes rendered messages to the dev notification preview instead of sending.
NOTIFICATION_CHANNELS="log"  # set to "email" once RESEND_API_KEY is in place

# Resend, for transactional email. THE WHOLE BOOKING FLOW RUNS ON THIS: the venue
# is alerted to each request, the customer gets the payment link, and the
# confirmation carries the calendar invite. Blank = nothing is sent.
# Get a key at resend.com and verify the sending domain.
RESEND_API_KEY=""
EMAIL_FROM="MadHaus <bookings@example.com>"

# Where the venue's own alerts go — new requests, submitted payments.
# Without it, staff are never told a request came in.
VENUE_NOTIFICATION_EMAIL=""

# WhatsApp Business / SMS provider. Blank = adapter disabled. A click-to-chat
# wa.me link is NOT this: it needs an approved Business API integration.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM_NUMBER=""

# --- Jobs -------------------------------------------------------------------
# Bearer token guarding /api/cron/* (hold sweeping, outbox delivery).
CRON_SECRET=""

# --- Staff bootstrap --------------------------------------------------------
# Used once by `npm run db:seed` to create the first owner account.
# Change the password immediately after first sign-in.
SEED_OWNER_EMAIL="owner@madhaus.local"
SEED_OWNER_PASSWORD=""
